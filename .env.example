# Local demo. Campaigns live in data/local-store.json.
DATA_BACKEND=local
SESSION_SECRET=local-dev-only-change-before-any-real-deploy
LOCAL_DEMO_EMAIL=yash@studio.test
LOCAL_DEMO_PASSWORD=studio-demo

# Required only when DATA_BACKEND=supabase.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Do not add SUPABASE_SERVICE_ROLE_KEY. v1 does not build a client with it.

# Optional. Without this key, a small offline parser handles pause, resume, budget, and create.
# GEMINI_API_KEY=

# Optional. Without these, parses are limited in server memory (20 per user per hour).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional. One Google sign-in lets the desk create a sheet and write the column names.
# Register the redirect in Google Cloud. The person never sees these values.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:3000/api/google/callback

# Optional. A public Google Sheet the desk can read. Writing columns uses Connect Google above.
# GOOGLE_SHEETS_ID=
# GOOGLE_SHEETS_API_KEY=
# GOOGLE_SHEETS_RANGE=Sheet1!A1:H500
